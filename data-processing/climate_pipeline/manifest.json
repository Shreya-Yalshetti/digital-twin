
{
  "project": "Climate Digital Twin",
  "source": "India Meteorological Department (IMD)",
  "period": {
    "start": "2015-01-01",
    "end": "2025-12-31",
    "daily_records": 4018
  },
  "spatial_subset": {
    "name": "Maharashtra bounding box",
    "latitude_range": [15.5, 21.5],
    "longitude_range": [73.5, 80.5],
    "grid_shape": [7, 8],
    "resolution": "1 degree"
  },
  "missing_value_handling": {
    "source_marker": 99.9,
    "replacement": "NaN",
    "imputation": false
  },
  "outputs": [
    {
      "variable": "tmax_c",
      "file": "data/processed/tmax_c_2015_2025.nc",
      "units": "degrees_Celsius"
    },
    {
      "variable": "tmin_c",
      "file": "data/processed/tmin_c_2015_2025.nc",
      "units": "degrees_Celsius"
    }
  ],
  "validation": {
    "dimensions_and_dates_checked": true,
    "missing_value_mask_checked_for_2019": true,
    "all_years_mask_validation_complete": true
  }
}
